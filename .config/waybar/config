{
    "modules-left": ["custom/power", "hyprland/workspaces","custom/sep-left","clock", "custom/media"],
    "modules-center": ["custom/window-title"],
    "modules-right": ["custom/weather","custom/download","custom/upload","custom/sep1","memory","custom/swap","custom/disk","custom/sep3","custom/uptime","custom/docker","tray","bluetooth","battery","custom/mic-status","pulseaudio","custom/brightness"],

    "custom/power": {
        "format" : "⭘ ",
        "tooltip": false,
        "on-click": "wlogout -b 5",
    },

    "custom/sep-left": {
        "exec": "~/.config/waybar/scripts/sep.sh",
        "interval": 999,
        "tooltip": false
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}",
        "cursor": true,
        "persistent-workspaces": {}
    },

"memory": {
  "format": "󰍛 {used:0.1f}G/{total:0.1f}G",
  "tooltip": false,
  "interval": 5
},

"custom/download": {
  "exec": "~/.config/waybar/scripts/download.sh",
  "interval": 1,
  "tooltip": false
},

"custom/upload": {
  "exec": "~/.config/waybar/scripts/upload.sh",
  "interval": 1,
  "tooltip": false
},

"custom/sep2": {
  "exec": "~/.config/waybar/scripts/sep.sh",
  "interval": 999,
  "tooltip": false
},

"custom/mic": {
  "exec": "~/.config/waybar/scripts/mic.sh",
  "on-click": "~/.config/waybar/scripts/mic.sh",
  "interval": 1,
  "tooltip": "Microphone"
},


"custom/nightlight": {
  "exec": "~/.config/waybar/scripts/nightlight-status.sh",
  "interval": 5,
  "on-click": "~/.config/waybar/scripts/nightlight.sh",
  "format": "{}"
},



"custom/media": {
  "exec": "~/.config/waybar/scripts/media.sh",
  "interval": 2,
  "tooltip": false,
  "on-click": "playerctl play-pause",
  "on-scroll-up": "playerctl next",
  "on-scroll-down": "playerctl previous"
},
"custom/weather": {
  "exec": "~/.config/waybar/scripts/weather.sh",
  "interval": 1800,
  "tooltip": true,
  "return-type": "json"
},


"custom/swap": {
  "exec": "~/.config/waybar/scripts/swap.sh",
  "interval": 5,
  "tooltip": false
},

"custom/disk": {
  "exec": "~/.config/waybar/scripts/disk.sh",
  "interval": 30,
  "tooltip": false
},

"custom/sep4": {
  "exec": "~/.config/waybar/scripts/sep.sh",
  "interval": 999,
  "tooltip": false
},

"custom/brightness": {
  "exec": "~/.config/waybar/scripts/brightness.sh",
  "interval": 1,
  "tooltip": false,
},
"custom/sep1": {
  "exec": "~/.config/waybar/scripts/sep.sh",
  "interval": 999,
  "tooltip": false
},

"custom/sep3": {
  "exec": "~/.config/waybar/scripts/sep.sh",
  "interval": 999,
  "tooltip": false
},

"hyprland/window-title": {
  "max-length": 80,
  "separator": " | ",
  "tooltip": false
},

"custom/window-title": {
  "exec": "~/.config/waybar/scripts/window-title.sh",
  "interval": 1,
  "tooltip": false
},

"custom/docker": {
  "exec": "~/.config/waybar/scripts/docker.sh",
  "interval": 30,
  "tooltip": false
},

"custom/uptime": {
  "exec": "~/.config/waybar/scripts/uptime.sh",
  "interval": 60,
  "tooltip": false
},

"custom/mic-status": {
  "exec": "~/.config/waybar/scripts/mic-status.sh",
  "interval": 5,
  "tooltip": false,
  "on-click": "~/.config/waybar/scripts/mic.sh"
},






    "tray": {
        "icon-size": 20,
        "spacing": 10,
        "cursor": true,
    },

    "bluetooth": {
        "format": " 󰂯 ",
        "format-disabled": " 󰂲 ",
        "format-connected": " 󰂱 ",
        "on-click": "blueman-manager",
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "  Ethernet",
        "format-linked": "  Linked (No IP)",
        "format-disconnected": "  Disconnected",
        "tooltip": false,
    },

    "battery": {
        "states": {
            "good": 85,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-plugged": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-alt": "{icon} {capacity}%",
        "format-icons": [" ", " ", " ", " ", " "],
        "tooltip-format": "{time}",
        "cursor": false,
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "  {volume}%",
        "format-bluetooth": " {volume}%",
        "format-bluetooth-muted": "  {volume}%",
        "format-icons": {
            "headphone": " ",
            "headset": " ",
            "default": [" "],
        },
        "on-click": "pavucontrol",
    },

    "clock": {
        "format": "{:%a %d/%m ~ %H:%M}",
        "tooltip-format": "<span size='15000'><tt>{calendar}</tt></span>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#F5C2E7'><b>{}</b></span>",
                "weekdays": "<span color='#89B4FA'><b>{}</b></span>",
                "days": "<span color='#CDD6F4'><b>{}</b></span>",
                "today": "<span color='#F9E2AF'><b>{}</b></span>",
            }
        },
        "on-click": "swaync-client -t -sw",
    }
}
